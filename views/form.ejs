
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form Simulasi</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #333;
        }

        nav {
            background: #1e3a5f;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav h2, nav a {
            color: white;
        }

        nav a {
            text-decoration: none;
            margin-left: 20px;
        }

        .container {
            max-width: 700px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.06);
        }

        h1 {
            color: #1e3a5f;
            margin-bottom: 10px;
        }

        p {
            color: #666;
            line-height: 1.6;
        }

        label {
            display: block;
            margin-top: 18px;
            font-size: 14px;
        }

        input {
            width: 100%;
            padding: 10px;
            margin-top: 7px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .btn {
            display: inline-block;
            padding: 12px 20px;
            border-radius: 7px;
            text-decoration: none;
            color: white;
            background: #1e3a5f;
            border: none;
            cursor: pointer;
            margin-top: 20px;
        }

        .secondary {
            background: #64748b;
            margin-left: 8px;
        }

        @media (max-width: 768px) {
            nav {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 0 8px;
            }
        }
    </style>
</head>

<body>

<nav>
    <h2>Simulasi Proyektil</h2>

    <div>
        <a href="/">Home</a>
        <a href="/form">Simulasi</a>
        <a href="/history">Riwayat</a>
    </div>
</nav>

<div class="container">

    <section class="card">

        <h1>Input Simulasi</h1>

        <p>Masukkan parameter gerak proyektil.</p>

        <form action="/simulate" method="POST">

            <label>Kecepatan Awal (m/s)</label>
            <input type="number" name="v0" step="any" value="20" required>

            <label>Sudut (derajat)</label>
            <input type="number" name="theta" step="any" value="45" required>

            <label>Massa (kg)</label>
            <input type="number" name="massa" step="any" value="1" required>

            <label>Koefisien Drag</label>
            <input type="number" name="cd" step="any" value="0.47" required>

            <label>Luas Penampang (m²)</label>
            <input type="number" name="area" step="any" value="0.01" required>

            <label>Massa Jenis Udara (kg/m³)</label>
            <input type="number" name="rho" step="any" value="1.225" required>

            <label>Gravitasi (m/s²)</label>
            <input type="number" name="gravity" step="any" value="9.81" required>

            <label>Time Step (s)</label>
            <input type="number" name="dt" step="any" value="0.01" required>

            <button type="submit" class="btn">Hitung Simulasi</button>

            <a href="/" class="btn secondary">Kembali</a>

        </form>

    </section>

</div>

</body>
</html>
