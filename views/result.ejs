
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hasil Simulasi</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #333;
        }

        nav {
            background: #1e3a5f;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav h2, nav a {
            color: white;
        }

        nav a {
            text-decoration: none;
            margin-left: 20px;
        }

        .container {
            max-width: 1100px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.06);
        }

        h1, h2 {
            color: #1e3a5f;
            margin-bottom: 15px;
        }

        .result {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .item {
            padding: 15px;
            background: #f4f6f9;
            border-radius: 6px;
        }

        .item p {
            color: #666;
            margin-bottom: 8px;
        }

        .item strong {
            color: #1e3a5f;
            font-size: 20px;
        }

        canvas {
            width: 100%;
            background: white;
            border: 1px solid #ddd;
        }

        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 600px;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: center;
        }

        th {
            background: #eef4fa;
            color: #1e3a5f;
        }

        .btn {
            display: inline-block;
            padding: 12px 20px;
            border-radius: 7px;
            text-decoration: none;
            color: white;
            background: #1e3a5f;
            margin-right: 10px;
        }

        .secondary {
            background: #64748b;
        }

        @media (max-width: 600px) {
            .result {
                grid-template-columns: 1fr;
            }

            nav {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 0 8px;
            }
        }
    </style>
</head>

<body>

<nav>
    <h2>Simulasi Proyektil</h2>

    <div>
        <a href="/">Home</a>
        <a href="/form">Simulasi</a>
        <a href="/history">Riwayat</a>
    </div>
</nav>

<div class="container">

    <h1>Hasil Simulasi</h1>

    <section class="card">

        <h2>Hasil Perhitungan</h2>

        <div class="result">

            <div class="item">
                <p>Jarak Maksimum</p>
                <strong><%= hasil.jarak %> m</strong>
            </div>

            <div class="item">
                <p>Tinggi Maksimum</p>
                <strong><%= hasil.tinggi %> m</strong>
            </div>

            <div class="item">
                <p>Waktu Terbang</p>
                <strong><%= hasil.waktu %> s</strong>
            </div>

            <div class="item">
                <p>Kecepatan</p>
                <strong><%= hasil.kecepatan %> m/s</strong>
            </div>

        </div>

    </section>

    <section class="card">

        <h2>Grafik Lintasan</h2>

        <canvas id="grafik" height="300"></canvas>

    </section>

    <section class="card">

        <h2>Data Simulasi</h2>

        <div class="table-container">

            <table>

                <thead>
                    <tr>
                        <th>Waktu (s)</th>
                        <th>Posisi X (m)</th>
                        <th>Posisi Y (m)</th>
                    </tr>
                </thead>

                <tbody id="dataTabel"></tbody>

            </table>

        </div>

    </section>

    <a href="/form" class="btn">Simulasi Lagi</a>
    <a href="/" class="btn secondary">Home</a>

</div>

<script id="trajectory-data" type="application/json"><%- JSON.stringify(trajectory || []) %></script>

<script src="/script.js"></script>

</body>
</html>